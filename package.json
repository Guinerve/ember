{
  "name": "ember",
  "private": true,
  "version": "0.2.0",
  "description": "An interactive model of bushfire physics, from flame radiation to McArthur Mk5 spread on real terrain near Canberra. For teaching only.",
  "license": "MIT",
  "engines": { "node": ">=22.18.0" },
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5194 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5194 --strictPort",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "katex": "^0.19.0",
    "three": "^0.180.0"
  }
}
